# Copy to .env and fill in. Never commit .env (it's gitignored).

PORT=4000

# Postgres — the shared_postgres container on shared-postgres-net.
# Same convention as every other app on that instance: one DB + one
# same-named owner role per app.
DATABASE_URL=postgresql://xpherobuilder:REPLACE_ME@shared_postgres:5432/xpherobuilder

# Long random strings — used to sign JWT access tokens. Rotate = every
# issued access token invalidates (refresh tokens are unaffected, they're
# stored/checked in Postgres, not signed by this secret).
JWT_SECRET=REPLACE_ME_WITH_A_LONG_RANDOM_STRING

# Where the frontend is actually served from — CORS is locked to this
# origin only (plus http://localhost:8080 for local dev). Loosen only
# temporarily for testing, same rule as the existing n8n webhooks. Must
# be a bare origin (no path) — it's compared against the browser's
# Origin header, which never includes one.
FRONTEND_ORIGIN=https://yo-repo87.github.io

# The real page URL OAuth callbacks redirect back to after sign-in. This
# is a GitHub *project* page (not a username.github.io root repo), so the
# site actually lives under /xp-hero-builder/ — redirecting to the bare
# FRONTEND_ORIGIN alone 404s ("There isn't a GitHub Pages site here").
# Falls back to FRONTEND_ORIGIN + '/' if left unset.
FRONTEND_REDIRECT_URL=https://yo-repo87.github.io/xp-hero-builder/

# Public base URL of *this* backend service (used to build OAuth redirect
# URIs) — set once the reverse-proxy subdomain is live.
API_BASE_URL=https://xpherobuilder-api.arc-it.uk

# --- OAuth providers ---------------------------------------------------
# Each is fully optional: a provider's login button only appears on the
# frontend once GET /auth/providers reports it configured (i.e. both
# vars below are set). Leave blank to skip a provider entirely for now.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Authorized redirect URI:
#   ${API_BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook Developers -> your app -> Facebook Login -> Settings.
# Valid OAuth Redirect URI:
#   ${API_BASE_URL}/auth/facebook/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Discord Developer Portal -> your app -> OAuth2 -> General. Redirect:
#   ${API_BASE_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
